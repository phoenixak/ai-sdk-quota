{
  "name": "ai-sdk-quota",
  "version": "0.1.0",
  "description": "Quota-aware model pool for the Vercel AI SDK: route each call to a model that still has headroom, before you hit a 429.",
  "license": "MIT",
  "author": "Ahmed Khaled (https://github.com/phoenixak)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phoenixak/ai-sdk-quota.git"
  },
  "homepage": "https://github.com/phoenixak/ai-sdk-quota#readme",
  "bugs": {
    "url": "https://github.com/phoenixak/ai-sdk-quota/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ai-sdk-quota": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./limits": {
      "import": {
        "types": "./dist/limits/index.d.ts",
        "default": "./dist/limits/index.js"
      },
      "require": {
        "types": "./dist/limits/index.d.cts",
        "default": "./dist/limits/index.cjs"
      }
    },
    "./stores/redis": {
      "import": {
        "types": "./dist/store/redis.d.ts",
        "default": "./dist/store/redis.js"
      },
      "require": {
        "types": "./dist/store/redis.d.cts",
        "default": "./dist/store/redis.cjs"
      }
    },
    "./stores/upstash": {
      "import": {
        "types": "./dist/store/upstash.d.ts",
        "default": "./dist/store/upstash.js"
      },
      "require": {
        "types": "./dist/store/upstash.d.cts",
        "default": "./dist/store/upstash.cjs"
      }
    },
    "./stores/postgres": {
      "import": {
        "types": "./dist/store/postgres.d.ts",
        "default": "./dist/store/postgres.js"
      },
      "require": {
        "types": "./dist/store/postgres.d.cts",
        "default": "./dist/store/postgres.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "ai",
    "ai-sdk",
    "vercel",
    "rate-limit",
    "quota",
    "fallback",
    "llm",
    "free-tier"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint:pkg": "publint && attw --pack . --profile node16",
    "check:terms": "sh scripts/check-private-terms.sh",
    "check:registry": "node scripts/check-registry.mjs",
    "test:services": "node scripts/test-services.mjs",
    "check:size": "node scripts/check-size.mjs"
  },
  "peerDependencies": {
    "@ai-sdk/provider": "^4.0.0"
  },
  "devDependencies": {
    "@ai-sdk/google": "^4.0.100",
    "@ai-sdk/groq": "^4.0.65",
    "@ai-sdk/provider": "^4.0.29",
    "@arethetypeswrong/cli": "^0.18.5",
    "@electric-sql/pglite": "^0.5.10",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.5",
    "ai": "^7.0.143",
    "ai-fallback": "^3.0.0",
    "fast-check": "^4.10.2",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
